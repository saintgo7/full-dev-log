# ============================================
# DevLog Hub - Server .dockerignore
# Exclude unnecessary files from Docker build
# ============================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs (we build in container)
dist
*.tsbuildinfo

# Development files
.env
.env.local
.env.*.local

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Git
.git
.gitignore

# Documentation
*.md
docs
README*
CHANGELOG*
LICENSE*

# Tests
**/*.test.ts
**/*.spec.ts
__tests__
coverage
.nyc_output
vitest.config.*

# Docker
Dockerfile*
docker-compose*
.docker

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Temporary files
tmp
temp
*.tmp

# Editor configs
.editorconfig
.prettierrc*
.eslintrc*
tsconfig.*.json
!tsconfig.json
