# ============================================
# DevLog Hub - Web Dashboard .dockerignore
# Exclude unnecessary files from Docker build
# ============================================

# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs (we build in container)
.next
out
build
*.tsbuildinfo

# Development files
.env
.env.local
.env.*.local

# IDE
.idea
.vscode
*.swp
*.swo
*~

# Git
.git
.gitignore

# Documentation
*.md
docs
README*
CHANGELOG*
LICENSE*

# Tests
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
__tests__
coverage
.nyc_output
vitest.config.*
jest.config.*
cypress
playwright

# Docker
Dockerfile*
docker-compose*
.docker

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log

# Temporary files
tmp
temp
*.tmp

# Editor configs
.editorconfig
.prettierrc*
.eslintrc*

# Storybook (if exists)
.storybook
storybook-static
