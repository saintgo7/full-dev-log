# ============================================
# DevLog Hub - Root .dockerignore
# Exclude files from Docker build context
# ============================================

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
docs
README*
CHANGELOG*
LICENSE*
CLAUDE.md

# IDE and Editors
.idea
.vscode
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files
.env
.env.local
.env.*.local
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
dist
build
out
*.tsbuildinfo

# Dependencies (per-service)
node_modules
vendor

# Test files
coverage
.nyc_output
__tests__
*.test.*
*.spec.*

# Development files
docker-compose.dev.yml
Dockerfile.dev

# Scripts (not needed in build)
scripts

# Temporary files
tmp
temp
*.tmp

# Data files
*.db
*.sqlite
data
